TUW_DATABASE_URL=sqlite:///./tuw-study-bot.db
TUW_LOG_LEVEL=INFO

# Required only for Telegram startup. Replace these placeholders in .env.
TUW_TELEGRAM_BOT_TOKEN=replace-with-bot-token
TUW_ALLOWED_TELEGRAM_USER_ID=replace-with-your-numeric-user-id

# Required only for the explicit TUWEL import.
TUW_TUWEL_TOKEN=replace-with-moodle-web-service-token
# Map selected Moodle course IDs to verified TU course numbers and semesters.
# {"<moodle-course-id>":{"course_code":"<course-number>","semester":"<YYYYS-or-YYYYW>"}}
TUW_TUWEL_COURSES={}
